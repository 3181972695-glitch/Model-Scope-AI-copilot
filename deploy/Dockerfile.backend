# 后端服务镜像：FastAPI + DeepSeek + GitHub 真实指标抓取
#
# 构建：  docker build -t msc-copilot-backend -f deploy/Dockerfile.backend .
# 运行：  docker run --rm -p 8000:8000 --env-file backend/.env msc-copilot-backend
# 验证：  curl http://127.0.0.1:8000/api/meta

FROM python:3.12-slim

WORKDIR /app

# 先拷依赖清单再装依赖，充分利用构建缓存
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./

# 容器内日志即时输出
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# 环境变量（DEEPSEEK_API_KEY / GITHUB_TOKEN 等）由运行时注入，见 backend/.env.example
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
