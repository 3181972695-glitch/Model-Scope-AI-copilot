# 后端环境变量模板。复制为 .env 并填入真实值；.env 已被 .gitignore 排除，不要提交。

# ── DeepSeek API（必填）──
# 在 https://platform.deepseek.com 申请。Key 只放这里或部署平台的环境变量，绝不写进代码/仓库。
DEEPSEEK_API_KEY=

# ── DeepSeek API（可选，默认如下）──
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 单次回答最大 token（推理模型思维链与正文共用，勿低于 2048）
MAX_TOKENS=4096

# 请求超时（秒）
REQUEST_TIMEOUT=30

# 是否启用思维链推理。开启后单轮可达 50s+，仅在需要深度归因分析时打开
ENABLE_REASONING=false

# ── 限流（公网部署建议保留）──
RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW_SECONDS=60

# ── GitHub 数据源（健康度诊断用，强烈建议配置）──
# 不配置也可运行，但未认证限量 60 次/小时（一次诊断约消耗 5 次）。
# 在 GitHub → Settings → Developer settings → Personal access tokens (classic) 生成，
# 无需勾选任何权限（只读公开仓库）。配置后限量提升到 5000 次/小时。
GITHUB_TOKEN=
GITHUB_API_TIMEOUT=12

# ── 多轮上下文 ──
MAX_HISTORY_MESSAGES=8
